#!/usr/bin/env python3
"""Background agent that caches unsealed TPM secrets in memory for a limited time.

Listens on a Unix socket under $XDG_RUNTIME_DIR. Secrets are held only in this
process's memory - never written to disk - and are dropped when they expire,
when explicitly locked, or when the agent exits (logout/reboot).
"""
import json
import os
import socket
import socketserver
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
SOCKET_PATH = RUNTIME_DIR / "tpm-secret-agent.sock"

STORE_DIR = Path(os.environ.get("TPM_SECRETS_DIR", str(Path.home() / ".local/share/tpm-secrets")))

cache = {}  # name -> (secret_bytes, expiry_time)
cache_lock = threading.Lock()


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def secret_paths(name):
    return STORE_DIR / f"{name}.pub", STORE_DIR / f"{name}.priv"


def unseal(name, pin):
    pub, priv = secret_paths(name)
    if not pub.exists() or not priv.exists():
        raise RuntimeError(f"no secret named '{name}' found in {STORE_DIR}")

    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)
        primary = tmpdir / "primary.ctx"
        subprocess.run(
            ["tpm2_createprimary", "-Q", "-C", "o", "-G", "ecc", "-g", "sha256", "-c", str(primary)],
            check=True, capture_output=True,
        )
        obj = tmpdir / "obj.ctx"
        subprocess.run(
            ["tpm2_load", "-Q", "-C", str(primary), "-u", str(pub), "-r", str(priv), "-c", str(obj)],
            check=True, capture_output=True,
        )
        cmd = ["tpm2_unseal", "-c", str(obj)]
        if pin is not None:
            pin_file = tmpdir / "pin"
            pin_file.write_text(pin)
            pin_file.chmod(0o600)
            cmd += ["-p", f"file:{pin_file}"]
        result = subprocess.run(cmd, check=True, capture_output=True)
        return result.stdout


def handle_unlock(req):
    name = req["name"]
    pin = req.get("pin")
    ttl = req.get("ttl") or 6 * 3600
    secret = unseal(name, pin)
    with cache_lock:
        cache[name] = (secret, time.time() + ttl)
    log(f"unlocked '{name}' for {ttl}s")
    return {"ok": True}


def handle_get(req):
    name = req["name"]
    with cache_lock:
        entry = cache.get(name)
        if entry is None:
            return {"ok": False, "error": "locked"}
        secret, expiry = entry
        if time.time() > expiry:
            del cache[name]
            return {"ok": False, "error": "expired"}
    return {"ok": True, "secret": secret.decode()}


def handle_lock(req):
    name = req.get("name")
    with cache_lock:
        if name:
            cache.pop(name, None)
        else:
            cache.clear()
    return {"ok": True}


def handle_status(req):
    name = req.get("name")
    now = time.time()
    with cache_lock:
        if name is not None:
            entry = cache.get(name)
            if entry is None:
                return {"ok": True, "cached": False}
            _, expiry = entry
            remaining = int(expiry - now)
            if remaining <= 0:
                del cache[name]
                return {"ok": True, "cached": False}
            return {"ok": True, "cached": True, "remaining": remaining}

        remaining_times = [int(expiry - now) for _, expiry in cache.values() if expiry > now]
    return {"ok": True, "count": len(remaining_times), "next_expiry": min(remaining_times) if remaining_times else None}


HANDLERS = {
    "unlock": handle_unlock,
    "get": handle_get,
    "lock": handle_lock,
    "status": handle_status,
}


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        line = self.rfile.readline()
        if not line:
            return
        try:
            req = json.loads(line.decode())
            handler = HANDLERS.get(req.get("cmd"))
            resp = {"ok": False, "error": f"unknown command {req.get('cmd')!r}"} if handler is None else handler(req)
        except Exception as exc:
            resp = {"ok": False, "error": str(exc)}
        self.wfile.write((json.dumps(resp) + "\n").encode())


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def gc_loop():
    while True:
        time.sleep(60)
        now = time.time()
        with cache_lock:
            for name in [n for n, (_, exp) in cache.items() if exp < now]:
                del cache[name]


def main():
    if SOCKET_PATH.exists():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(str(SOCKET_PATH))
            log(f"agent already running at {SOCKET_PATH}")
            sys.exit(1)
        except OSError:
            SOCKET_PATH.unlink()

    threading.Thread(target=gc_loop, daemon=True).start()

    server = Server(str(SOCKET_PATH), Handler)
    os.chmod(SOCKET_PATH, 0o600)
    log(f"tpm-secret-agent listening on {SOCKET_PATH}")
    try:
        server.serve_forever()
    finally:
        SOCKET_PATH.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
