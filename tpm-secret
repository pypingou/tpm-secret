#!/usr/bin/env python3
"""CLI to seal/unseal secrets in the TPM, backed by tpm2-tools."""
import argparse
import getpass
import json
import os
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DEFAULT_STORE_DIR = Path(
    os.environ.get("TPM_SECRETS_DIR", str(Path.home() / ".local/share/tpm-secrets"))
)

AGENT_SCRIPT = Path(__file__).resolve().parent / "tpm-secret-agent"
AGENT_SOCKET = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "tpm-secret-agent.sock"


def die(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def run(cmd, **kwargs):
    try:
        return subprocess.run(cmd, check=True, **kwargs)
    except FileNotFoundError:
        die(f"'{cmd[0]}' not found - is tpm2-tools installed?")
    except subprocess.CalledProcessError as exc:
        stderr = exc.stderr.decode(errors="replace") if isinstance(exc.stderr, bytes) else (exc.stderr or "")
        die(f"'{' '.join(cmd)}' failed{': ' + stderr.strip() if stderr else ''}")


def create_primary(tmpdir):
    primary = tmpdir / "primary.ctx"
    run(["tpm2_createprimary", "-Q", "-C", "o", "-G", "ecc", "-g", "sha256", "-c", str(primary)])
    return primary


def secret_paths(store_dir, name):
    return store_dir / f"{name}.pub", store_dir / f"{name}.priv", store_dir / f"{name}.pin"


def format_duration(seconds):
    hours, rem = divmod(int(seconds), 3600)
    minutes = rem // 60
    if hours and minutes:
        return f"{hours}h{minutes}m"
    if hours:
        return f"{hours}h"
    return f"{minutes}m"


def prompt_confirmed(label):
    first = getpass.getpass(f"{label}: ")
    second = getpass.getpass("Confirm: ")
    if first != second:
        die(f"{label.lower()}s did not match")
    return first


def agent_request(req, timeout=2):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect(str(AGENT_SOCKET))
            s.sendall((json.dumps(req) + "\n").encode())
            data = s.recv(65536)
        return json.loads(data.decode())
    except OSError:
        return None


def ensure_agent_running():
    if agent_request({"cmd": "status"}) is not None:
        return
    if not AGENT_SCRIPT.exists():
        die(f"agent script not found at {AGENT_SCRIPT}")
    subprocess.Popen(
        [sys.executable, str(AGENT_SCRIPT)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(50):
        if agent_request({"cmd": "status"}) is not None:
            return
        time.sleep(0.1)
    die("timed out waiting for tpm-secret-agent to start")


def direct_unseal(store_dir, name, pin_marker):
    pub, priv, _ = secret_paths(store_dir, name)
    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)
        primary = create_primary(tmpdir)

        obj = tmpdir / "obj.ctx"
        run(["tpm2_load", "-Q", "-C", str(primary), "-u", str(pub), "-r", str(priv), "-c", str(obj)])

        unseal_cmd = ["tpm2_unseal", "-c", str(obj)]
        if pin_marker.exists():
            pin = getpass.getpass("PIN: ")
            pin_file = tmpdir / "pin"
            pin_file.write_text(pin)
            pin_file.chmod(0o600)
            unseal_cmd += ["-p", f"file:{pin_file}"]

        result = run(unseal_cmd, stdout=subprocess.PIPE)
        return result.stdout


def cmd_insert(args):
    store_dir = args.dir
    pub, priv, pin_marker = secret_paths(store_dir, args.name)

    if pub.exists() or priv.exists():
        die(f"a secret named '{args.name}' already exists in {store_dir}")

    store_dir.mkdir(parents=True, exist_ok=True)
    store_dir.chmod(0o700)

    secret = prompt_confirmed("Secret to seal")
    pin = None if args.no_pin else prompt_confirmed("PIN to protect secret")

    with tempfile.TemporaryDirectory() as tmp:
        tmpdir = Path(tmp)
        primary = create_primary(tmpdir)

        create_cmd = [
            "tpm2_create", "-Q",
            "-C", str(primary),
            "-u", str(pub), "-r", str(priv),
            "-i", "-",
        ]
        if pin is not None:
            pin_file = tmpdir / "pin"
            pin_file.write_text(pin)
            pin_file.chmod(0o600)
            create_cmd += ["-p", f"file:{pin_file}"]

        run(create_cmd, input=secret.encode())

    pub.chmod(0o600)
    priv.chmod(0o600)
    if pin is not None:
        pin_marker.touch()
        pin_marker.chmod(0o600)
    elif pin_marker.exists():
        pin_marker.unlink()

    print(f"Sealed secret '{args.name}' into the TPM.")
    if pin is not None:
        print("Remember the PIN - it is required to retrieve this secret.")


def cmd_get(args):
    store_dir = args.dir
    pub, priv, pin_marker = secret_paths(store_dir, args.name)

    if not pub.exists() or not priv.exists():
        die(f"no secret named '{args.name}' found in {store_dir}")

    resp = agent_request({"cmd": "get", "name": args.name})
    if resp and resp.get("ok"):
        sys.stdout.write(resp["secret"])
        return

    # Agent not running, or secret not cached/expired there - fall back to a
    # direct unseal (will prompt for the PIN if this secret requires one).
    sys.stdout.buffer.write(direct_unseal(store_dir, args.name, pin_marker))


def cmd_unlock(args):
    store_dir = args.dir
    ensure_agent_running()

    ttl_seconds = args.ttl * 60

    had_error = False
    for name in args.name:
        pub, priv, pin_marker = secret_paths(store_dir, name)
        if not pub.exists() or not priv.exists():
            print(f"Error: no secret named '{name}' found in {store_dir}", file=sys.stderr)
            had_error = True
            continue

        pin = getpass.getpass(f"{name} PIN: ") if pin_marker.exists() else None
        resp = agent_request({"cmd": "unlock", "name": name, "pin": pin, "ttl": ttl_seconds})
        if resp is None:
            die("could not reach tpm-secret-agent")
        if not resp.get("ok"):
            print(f"Error: {name}: {resp.get('error', 'unlock failed')}", file=sys.stderr)
            had_error = True
            continue

        print(f"Unlocked '{name}' for {format_duration(ttl_seconds)}.")

    if had_error:
        sys.exit(1)


def cmd_lock(args):
    resp = agent_request({"cmd": "lock", "name": args.name})
    if resp is None:
        print("tpm-secret-agent is not running - nothing to lock.")
        return
    print(f"Locked '{args.name}'." if args.name else "Locked all cached secrets.")


def cmd_agent_status(args):
    resp = agent_request({"cmd": "status"})
    if resp is None:
        print("tpm-secret-agent is not running.")
        return
    cached = resp.get("cached", {})
    if not cached:
        print("No secrets currently cached.")
        return
    for name, seconds in cached.items():
        print(f"{name}: {format_duration(seconds)} remaining")


def cmd_list(args):
    store_dir = args.dir
    if not store_dir.is_dir():
        print("No secrets stored.")
        return

    names = sorted(p.stem for p in store_dir.glob("*.pub"))
    if not names:
        print("No secrets stored.")
        return

    for name in names:
        _, _, pin_marker = secret_paths(store_dir, name)
        tag = " (pin-protected)" if pin_marker.exists() else ""
        print(f"{name}{tag}")


def cmd_delete(args):
    store_dir = args.dir
    pub, priv, pin_marker = secret_paths(store_dir, args.name)

    if not pub.exists() and not priv.exists():
        die(f"no secret named '{args.name}' found in {store_dir}")

    if not args.force:
        answer = input(f"Delete secret '{args.name}'? [y/N] ")
        if answer.strip().lower() not in ("y", "yes"):
            print("Aborted.")
            return

    for path in (pub, priv, pin_marker):
        path.unlink(missing_ok=True)
    print(f"Deleted secret '{args.name}'.")


def main():
    parser = argparse.ArgumentParser(
        prog="tpm-secret",
        description="Seal and unseal secrets using the TPM (via tpm2-tools).",
    )
    parser.add_argument(
        "--dir", type=Path, default=DEFAULT_STORE_DIR,
        help=f"storage directory (default: {DEFAULT_STORE_DIR})",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_insert = sub.add_parser("insert", help="seal a new secret into the TPM")
    p_insert.add_argument("name", help="name for this secret")
    p_insert.add_argument("--no-pin", action="store_true", help="don't protect the secret with a PIN (PIN is required by default)")
    p_insert.set_defaults(func=cmd_insert)

    p_get = sub.add_parser("get", help="unseal and print a secret")
    p_get.add_argument("name", help="name of the secret to retrieve")
    p_get.set_defaults(func=cmd_get)

    p_list = sub.add_parser("list", help="list stored secrets")
    p_list.set_defaults(func=cmd_list)

    p_delete = sub.add_parser("delete", help="delete a stored secret")
    p_delete.add_argument("name", help="name of the secret to delete")
    p_delete.add_argument("-f", "--force", action="store_true", help="skip confirmation prompt")
    p_delete.set_defaults(func=cmd_delete)

    p_unlock = sub.add_parser(
        "unlock",
        help="cache one or more secrets in the background agent for a limited time",
        description="Cache one or more secrets in the background agent for a limited time.",
        epilog=(
            "examples:\n"
            "  tpm-secret unlock mysecret                  cache for the default TTL (6h)\n"
            "  tpm-secret unlock mysecret --ttl 30         cache for 30 minutes\n"
            "  tpm-secret unlock mysecret --ttl 60         cache for 1 hour\n"
            "  tpm-secret unlock mysecret --ttl 240        cache for 4 hours\n"
            "  tpm-secret unlock mysecret --ttl 360        cache for 6 hours\n"
            "  tpm-secret unlock mysecret --ttl 480        cache for 8 hours\n"
            "  tpm-secret unlock mysecret --ttl 720        cache for 12 hours\n"
            "  tpm-secret unlock wifi vpn github --ttl 60  unlock several secrets at once\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_unlock.add_argument("name", nargs="+", help="name(s) of the secret(s) to unlock")
    p_unlock.add_argument("--ttl", type=int, default=6 * 60, help="cache lifetime in minutes (default: 360 = 6h)")
    p_unlock.set_defaults(func=cmd_unlock)

    p_lock = sub.add_parser("lock", help="remove a secret (or all) from the agent cache")
    p_lock.add_argument("name", nargs="?", help="name to lock (omit to lock everything)")
    p_lock.set_defaults(func=cmd_lock)

    p_status = sub.add_parser("agent-status", help="show what the agent currently has cached")
    p_status.set_defaults(func=cmd_agent_status)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
